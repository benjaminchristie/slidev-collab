#!/usr/bin/env bash
#
# Serve a deck in the browser.
#
#   ./present my-talk
#   ./present 2026-08-31          # a bare name, if one deck matches
#   ./present meetings/2026-08-31
#   ./present my-talk --no-open   # do not open browser tabs
#
# Two tabs open once the server answers: the deck and the presenter view. The
# presenter tab is opened second, so it is the one in front — that is the one
# you drive the talk from.
#
# The deck is required. There is no default: with seventeen decks in the repo,
# silently serving one of them is a worse outcome than being told to name it.
#
# This wraps `PRESENTATION=<deck> docker compose -f compose.slidev.yml up`
# rather than taking the deck as a container argument, because Compose resolves
# bind mounts before the container starts: making the deck folder *be* the
# project root is what gives instant hot reload, and that has to happen at
# compose time, not inside the container.

set -euo pipefail
cd "$(dirname "$0")"

COMPOSE_FILE=compose.slidev.yml

list_decks() {
  find . -name slides.md \
       -not -path '*/node_modules/*' \
       -not -path './common/*' \
       -not -path './build/*' \
       -printf '%h\n' | sed 's|^\./||' | sort
}

if [ $# -eq 0 ]; then
  echo "usage: ./present <deck> [extra compose args...]" >&2
  echo "" >&2
  echo "available decks:" >&2
  list_decks | sed 's/^/  /' >&2
  exit 2
fi

deck=$1
shift
deck=${deck%/}

if [ ! -f "$deck/slides.md" ]; then
  # Allow a bare name — "2026-08-31" instead of "meetings/2026-08-31" —
  # as long as exactly one deck matches.
  mapfile -t matches < <(list_decks | grep -E "(^|/)$(printf '%s' "$deck" | sed 's/[][\.*^$/]/\\&/g')$" || true)
  case ${#matches[@]} in
    1) deck=${matches[0]} ;;
    0) echo "no such deck: $deck" >&2
       echo "available:" >&2
       list_decks | sed 's/^/  /' >&2
       exit 1 ;;
    *) echo "ambiguous: $deck matches several decks" >&2
       printf '  %s\n' "${matches[@]}" >&2
       exit 1 ;;
  esac
fi

# Fixed in compose.slidev.yml, which publishes 3030 on the host.
BASE_URL=http://localhost:3030

# Our own flags are consumed here; everything else is passed on to compose.
open_browser=1
args=()
for arg in "$@"; do
  case $arg in
    --no-open) open_browser=0 ;;
    *) args+=("$arg") ;;
  esac
done
set -- ${args+"${args[@]}"}

echo "serving $deck"
echo "  deck       $BASE_URL/"
echo "  presenter  $BASE_URL/presenter"
echo "  overview   $BASE_URL/overview"

if [ "$open_browser" -eq 1 ]; then
  # The server below runs in the foreground, so the browser has to be opened by
  # something that is not this shell. Backgrounded now, it waits for the deck to
  # answer and then opens both tabs; it gives up quietly if there is no browser.
  tools/open-when-ready.sh "$BASE_URL" / /presenter &
fi

exec env PRESENTATION="$deck" docker compose -f "$COMPOSE_FILE" up "$@"
